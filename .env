# --- MySQL 容器配置 ---
# 数据库 root 的密码 (这是最高权限密码)
MYSQL_ROOT_PASSWORD=root123456

# 应用使用的数据库名
MYSQL_DATABASE=tdrm

# 【重要修改】应用使用的用户名 (不能写 root，必须是新名字)
MYSQL_USER=tdrm_user

# 【重要修改】应用使用的密码 (这是给 tdrm_user 用的)
MYSQL_PASSWORD=tdrm_password

# MySQL 内部端口 (保持默认)
MYSQL_PORT=3306


# --- Web 容器配置 ---
# 这里的端口映射到宿主机的 5001
WEB_PORT=5001
FLASK_APP=TDRM.py
FLASK_DEBUG=0
# 生产环境务必修改这个密钥
SECRET_KEY=sk_7d8f9a2b3c4d5e6f7a8b9c0d1e2f3a4b

# --- 邮箱配置 (保持不变) ---
